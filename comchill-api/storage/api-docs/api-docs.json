    "openapi": "3.0.0",
    "info": {
        "title": "ComChill Core API Documentation",
        "description": "REST API endpoints for ComChill student messaging platform",
        "contact": {
            "email": "franciscohermas@gmail.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "ComChill Local Development API Server"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Authenticate user and generate Sanctum token",
                "description": "Handle incoming registration request via phone number.",
                "operationId": "c70216c475678641e0ff0f135de07573",
                "responses": {
                    "200": {
                        "description": "User authenticated successfully"
                    },
                    "401": {
                        "description": "Invalid credentials provided"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Enter your Sanctum token to access protected routes",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        }
    ]
}